{
  "id": "e8-fpc-vrdet-x-vec-24e",
  "gpu": "G4",
  "bundle": [
    "vrdet",
    "colab"
  ],
  "setup": [
    "pip install -q -U gdown shapely"
  ],
  "cmd": "python -u colab/data/floorplancad.py --root /content/datasets && python -u -m vrdet.train --data /content/datasets/floorplancad_1024 --out {out} --size x --epochs 24 --batch 8 --lr 6e-5 --backbone-mult 0.1 --wd 1.25e-4 --workers 16 --eval-every 6 --eval-images 100 --channels-last --compile --rfs 0.1 --vectors",
  "sync": [
    "last.pt",
    "metrics.jsonl",
    "*.log",
    "eval_val.json",
    "eval_val.txt",
    "train_done"
  ],
  "max_hours": 8,
  "max_retries": 4,
  "est_cu": 30
}
