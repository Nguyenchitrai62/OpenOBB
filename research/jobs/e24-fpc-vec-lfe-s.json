{
  "id": "e24-fpc-vec-lfe-s",
  "gpu": "G4",
  "bundle": [
    "vrdet",
    "colab"
  ],
  "setup": [
    "pip install -q -U gdown shapely"
  ],
  "cmd": "python -u colab/data/floorplancad.py --root /content/datasets && python -u -m vrdet.train --data /content/datasets/floorplancad_1024 --out {out} --size s --epochs 24 --batch 16 --lr 1e-4 --workers 16 --eval-every 6 --eval-images 100 --channels-last --compile --rfs 0.1 --vectors --vec-lfe --layer-drop 0.1",
  "sync": [
    "last.pt",
    "metrics.jsonl",
    "*.log",
    "eval_val.json",
    "eval_val.txt",
    "train_done"
  ],
  "max_hours": 4,
  "max_retries": 3,
  "est_cu": 7
}
